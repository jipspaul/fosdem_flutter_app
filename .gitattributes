# Auto detect text files and perform LF normalization
* text=auto

# Flutter specific
*.dart text
*.yaml text
*.json text
*.md text

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Config files
.gitignore text
.gitattributes text
pubspec.yaml text
pubspec.lock text -diff
analysis_options.yaml text

# Generated files (exclude from diffs)
*.g.dart linguist-generated=true
*.freezed.dart linguist-generated=true
*.mocks.dart linguist-generated=true
